<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/createTitleUnd"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="0dp">

        <FrameLayout
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="345dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/edtbox" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full name"
                android:textColor="@color/gray" />

            <EditText
                android:id="@+id/editTextText2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="30dp"
                android:background="@color/trans"
                android:ems="10"
                android:hint="Ivanov Ivan"
                android:inputType="text"
                android:text=""
                android:textSize="16sp" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/phoneNumber"
            android:layout_width="match_parent"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="345dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/edtbox" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone number"
                android:textColor="@color/gray" />

            <EditText
                android:id="@+id/editTextPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="30dp"
                android:background="@color/trans"
                android:ems="10"
                android:hint="+7(999)999-99-99"
                android:inputType="phone"
                android:text=""
                android:textSize="16sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="345dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/edtbox" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="@color/gray" />

            <EditText
                android:id="@+id/editTextTextEmailAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="30dp"
                android:background="@color/trans"
                android:ems="10"
                android:hint="***********@mail.com"
                android:inputType="textEmailAddress"
                android:text=""
                android:textSize="16sp" />


        </FrameLayout>

        <FrameLayout
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="345dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/edtbox" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/gray" />

            <EditText
                android:id="@+id/editTextTextPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="30dp"
                android:background="@color/trans"
                android:ems="10"
                android:hint="**********"
                android:inputType="textPassword"
                android:text=""
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/hidePass"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="right"
                android:layout_marginTop="32dp"
                android:layout_marginRight="50dp"
                android:background="@color/white"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/eyeslash" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/confirmPass"
            android:layout_width="match_parent"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="345dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/edtbox" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textColor="@color/gray" />

            <EditText
                android:id="@+id/editTextTextPassword2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="30dp"
                android:background="@color/trans"
                android:ems="10"
                android:hint="**********"
                android:inputType="textPassword"
                android:text=""
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/hidePass2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="right"
                android:layout_marginTop="32dp"
                android:layout_marginRight="50dp"
                android:background="@color/white"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/eyeslash" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <CheckBox
                android:id="@+id/termsAndConds"
                android:layout_width="314dp"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blu"
                android:text="By ticking this box, you agree to our Terms and conditions and private policy"
                android:textAlignment="center"
                android:textColor="@color/gray"
                android:textSize="12sp" />
        </FrameLayout>

        <Button
            android:id="@+id/signUpBtt"
            android:layout_width="345dp"
            android:layout_height="60dp"
            android:backgroundTint="@color/gray"
            android:text="Sign up"
            app:cornerRadius="4dp" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="345dp"
            android:layout_height="wrap_content"
            android:text="Already have an account? Sign in"
            android:textAlignment="center"
            android:textColor="@color/gray" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="345dp"
            android:layout_height="wrap_content"
            android:text="or sign in using"
            android:textAlignment="center"
            android:textColor="@color/gray" />

        <FrameLayout
            android:layout_width="345dp"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/imageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:backgroundTint="@color/white"
                app:srcCompat="@drawable/gglicon" />
        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/createTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="56dp"
        android:text="Create an account"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/createTitleUnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="12dp"
        android:text="Complete the sign up process to get started"
        android:textColor="@color/gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/createTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>